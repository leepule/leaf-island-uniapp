{
  "id": "animal-island",
  "displayName": "Animal Island UI",
  "version": "0.2.0",
  "license": "CC-BY-NC-4.0",
  "description": "自然治愈系 uni-app 组件库（Vue 3），由 animal-island-vue 改造而来。已验证平台：H5、微信小程序；App 及其他小程序端尚未验证（详见 README 平台支持表）。",
  "repository": "https://github.com/guokaigdg/animal-island-vue",
  "keywords": [
    "uni-app",
    "ui",
    "components",
    "vue3",
    "animal-island",
    "nature"
  ],
  "dcloudext": {
    "type": "component-vue",
    "sale": {
      "regular": {
        "price": "0"
      }
    }
  },
  "uni_modules": {
    "dependencies": [],
    "encrypt": false,
    "platforms": {
      "cloud": false,
      "spa": true,
      "app": false,
      "web": true,
      "ios": false,
      "android": false,
      "mp-weixin": true,
      "mp-alipay": false,
      "mp-baidu": false,
      "mp-toutiao": false,
      "mp-qq": false,
      "mp-kuaishou": false,
      "mp-lark": false,
      "mp-jd": false,
      "quickapp": false
    }
  },
  "easycom": {
    "autoscan": false,
    "custom": {
      "^ai-(.*)": "uni_modules/animal-island/components/ai-$1/ai-$1.vue"
    }
  },
  "peerDependencies": {
    "vue": ">=3.4.0"
  }
}
